# Variables de entorno del servicio de turnos.
# Copiar como .env y completar. El .env no se sube al repositorio.

# Servicio de catálogo
CATALOG_BASE_URL=http://localhost:8081

# Secreto para firmar y validar los JWT (base64). Tiene que ser EL MISMO en el catálogo,
# porque el catálogo valida los tokens que emite este servicio.
# Se genera con: openssl rand -base64 64 | tr -d '\n'
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64SECRET=

# API REST de la cátedra (datos de la cuenta de integración)
CATEDRA_BASE_URL=
CATEDRA_TOKEN=
