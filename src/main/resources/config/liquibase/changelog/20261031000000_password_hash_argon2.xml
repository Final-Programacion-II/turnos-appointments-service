<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        JHipster crea password_hash como varchar(60), el largo exacto de un hash bcrypt.
        Un hash de Argon2id con el prefijo {argon2} ocupa unos 105 caracteres.
        Se agranda en un changeset nuevo para no tocar el inicial, que ya está aplicado.
    -->
    <changeSet id="20261031000000-1" author="facumangione">
        <modifyDataType tableName="jhi_user" columnName="password_hash" newDataType="varchar(255)"/>
    </changeSet>
</databaseChangeLog>
