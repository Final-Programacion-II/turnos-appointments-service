# Variables del sistema en Docker. Copiar como docker/.env y completar.
# El .env no se sube al repositorio.
#
# Los valores de la cátedra son los mismos que ya están en el .env de cada servicio.

# Contraseñas de las dos bases (se crean con estos valores la primera vez)
CATALOG_DB_PASSWORD=
APPOINTMENTS_DB_PASSWORD=

# Secreto de los JWT (base64), el mismo para los dos servicios
JWT_BASE64_SECRET=

# API de la cátedra y JWT técnico de la cuenta de integración
CATEDRA_BASE_URL=
CATEDRA_TOKEN=
CATEDRA_GROUP_ID=

# Redis de la cátedra (lo usa el catálogo)
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Kafka de la cátedra
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CATALOG_TOPIC=
KAFKA_ACTIONS_TOPIC=
KAFKA_PHONE_TOPIC=
# Un consumer group distinto para cada servicio
CATALOG_KAFKA_GROUP_ID=
APPOINTMENTS_KAFKA_GROUP_ID=
